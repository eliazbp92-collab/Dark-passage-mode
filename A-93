--// Load Asset Safely
local assets = game:GetObjects(ASSET_ID)
if not assets or #assets == 0 then
    warn("A-60 asset failed to load")
    return
end

local root = assets[1]
local model = root:IsA("Model") and root or nil
if not model then
    for _, vmix in ipairs(root:GetDescendants()) do
        if vmix:IsA("Model") then model = vmix; break end
    end
end

if not model then
    warn("No model container found!")
    return
end

model.Name = "A-60"
model.Parent = workspace

-- Locate HumanoidRootPart or base block wrapper dynamically
local hrp = model:WaitForChild("HumanoidRootPart", 10) or model:FindFirstChildWhichIsA("BasePart")
if not hrp then 
    warn("HumanoidRootPart or Core Part missing!")
    return 
end

-- Turn off collision properties across all parts
for _, part in ipairs(model:GetDescendants()) do
    if part:IsA("BasePart") then
        part.CanCollide = false
    end
end

